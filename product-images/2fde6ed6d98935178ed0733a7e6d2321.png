<link rel='preload' as='style' onload="this.onload=null;this.rel='stylesheet'" id='wawp-intl-tel-input-css-css' href='https://ilmstore.com.np/wp-content/plugins/automation-web-platform/assets/css/intlTelInput.css?ver=26.9.2' media='all' />
<style id="wawp-intl-tel-input-css-inline-css">
 .iti__flag { background-image: var(--wpr-bg-c443fbb3-4e6d-42b6-9745-612afd534d2e); }
			.iti__il { background-position: -2848px 0 !important; }
			@media (-webkit-min-device-pixel-ratio: 2), (min-resolution: 192dpi) {
				.iti__flag { background-image: var(--wpr-bg-c443fbb3-4e6d-42b6-9745-612afd534d2e); }
				.iti__il { background-position: -2848px 0 !important; }
			}
			.iti.iti--allow-dropdown input { padding-top: 10px !important; padding-bottom: 10px !important; }
			.iti--flag-left input { padding-left: 55px !important; padding-right: 12px !important; text-align: left !important; }
			.iti--flag-right input { padding-right: 55px !important; padding-left: 12px !important; text-align: right !important; }
			.iti__country-container { z-index: 5 !important; }
			.iti__selected-flag { border: none !important; background: transparent !important; outline: none !important; }
			.iti { display: block !important; width: 100% !important; position: relative !important; background: transparent !important; overflow: visible !important; }
			.iti input[type='tel'], .iti input.iti__tel-input { background: transparent !important; width: 100% !important; display: block !important; box-sizing: border-box !important; }
			.iti__country-container { position: absolute !important; top: 0 !important; bottom: 0 !important; z-index: 5 !important; }
			.iti--flag-right .iti__country-container { right: 0 !important; left: auto !important; }
			.iti--flag-left .iti__country-container { left: 0 !important; right: auto !important; }
			.iti__dropdown-content { position: absolute !important; top: 100% !important; height: auto !important; max-height: 280px !important; border-radius: 12px !important; box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.15), 0 8px 10px -6px rgba(0, 0, 0, 0.08) !important; border: 1px solid #e5e7eb !important; margin-top: 4px !important; z-index: 999999 !important; background: #ffffff !important; background-color: #ffffff !important; min-width: 280px !important; max-width: 90vw !important; box-sizing: border-box !important; }
			.iti--flag-right .iti__dropdown-content { right: 0 !important; left: auto !important; }
			.iti--flag-left .iti__dropdown-content { left: 0 !important; right: auto !important; }
			.iti__search-input-wrapper { background: #ffffff !important; background-color: #ffffff !important; border-bottom: 1px solid #f3f4f6 !important; border-radius: 12px 12px 0 0 !important; position: relative !important; }
			.iti__search-input { background: #ffffff !important; background-color: #ffffff !important; color: #1f2937 !important; padding: 12px 15px !important; border: none !important; font-size: 14px !important; outline: none !important; width: 100% !important; box-sizing: border-box !important; border-radius: 12px 12px 0 0 !important; }
			.iti__country-list { max-height: 220px !important; overflow-y: auto !important; display: block !important; margin: 0 !important; padding: 0 !important; background: #ffffff !important; background-color: #ffffff !important; list-style: none !important; border-radius: 0 0 12px 12px !important; }
			.iti__country { padding: 10px 15px !important; outline: none !important; display: flex !important; align-items: center !important; gap: 10px !important; background: #ffffff !important; background-color: #ffffff !important; color: #1f2937 !important; }
			.iti__country:hover, .iti__country.iti__highlight { background: #f3f4f6 !important; background-color: #f3f4f6 !important; }
			.iti--flag-right .iti__country { display: flex !important; flex-direction: row !important; justify-content: flex-start !important; gap: 10px !important; }
			.iti--flag-right .iti__flag-box { margin-left: 0 !important; margin-right: 0 !important; }
			.iti--container, .iti--fullscreen-popup.iti--container { z-index: 999999 !important; }
			
/*# sourceURL=wawp-intl-tel-input-css-inline-css */
</style>
