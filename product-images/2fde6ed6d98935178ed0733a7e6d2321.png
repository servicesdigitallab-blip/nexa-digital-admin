	font-style: normal;
	src: url("//ilmstore.com.np/wp-content/plugins/woocommerce/assets/fonts/star.eot?#iefix") format("embedded-opentype"), url("//ilmstore.com.np/wp-content/plugins/woocommerce/assets/fonts/star.woff") format("woff"), url("//ilmstore.com.np/wp-content/plugins/woocommerce/assets/fonts/star.ttf") format("truetype"), url("//ilmstore.com.np/wp-content/plugins/woocommerce/assets/fonts/star.svg#star") format("svg");
}

